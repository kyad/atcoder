ll dp[300][300][501];
{
  ll@(N,M,Q),@(H[N],V[N]);
  rep(i,N)dp[i][i][H[i]]=V[i];
  rep(i,N)rep(j,i,N)rep(k,M+1){
    if(i>0){
      dp[i-1][j][k]>?=dp[i][j][k];
      if(k>=H[i-1])dp[i-1][j][k]>?=dp[i][j][k-H[i-1]]+V[i-1];
    }
    if(j+1<N){
      dp[i][j+1][k]>?=dp[i][j][k];
      if(k>=H[j+1])dp[i][j+1][k]>?=dp[i][j][k-H[j+1]]+V[j+1];
    }
  }
  rep(Q){
    ll@(L--,R--,X);
    wt(max[k,0,X+1](dp[L][R][k]));
  }
}
