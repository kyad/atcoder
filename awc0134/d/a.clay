ll d[300][300][501];{ll@(N,M,Q),@(H[N],V[N]);rep(i,N)d[i][i][H[i]]=V[i];rep(i,N)rep(j,i,N)rep(k,M+1){if(i>0){d[i-1][j][k]>?=d[i][j][k];if(k>=H[i-1])d[i-1][j][k]>?=d[i][j][k-H[i-1]]+V[i-1];}if(j+1<N){d[i][j+1][k]>?=d[i][j][k];if(k>=H[j+1])d[i][j+1][k]>?=d[i][j][k-H[j+1]]+V[j+1];}}rep(Q){ll@(L--,R--,X);wt(max[k,0,X+1](d[L][R][k]));}}
